[Unit]
Description=18:32 cheat license server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
Environment=LICENSE_HOST=0.0.0.0
Environment=LICENSE_PORT=8000
ExecStart=__APP_DIR__/license/.venv/bin/python -m license.server.run
Restart=always
RestartSec=3
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
